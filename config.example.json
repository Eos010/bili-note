    "device": "auto",
    "cpu_threads": 0,
    "beam_size": 5
  },
  "models": {
    "dir": "",
    "endpoint": "mirror",
    "custom_endpoint": "",
    "proxy": ""
  },
  "ui": {
    "onboarded": false
  }
}
